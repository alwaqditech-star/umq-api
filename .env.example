# Database (MySQL) — UMQ Platform schema (Prisma)
DATABASE_URL="mysql://root@127.0.0.1:3306/umq_platform"

# Docker: docker compose up -d mysql (host port 3307)
# DATABASE_URL="mysql://umq:umq_dev_password@localhost:3307/umq_platform"

# TiDB Cloud (remote)
# DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/umq_db?sslaccept=strict"

# API
API_PORT=4001
NODE_ENV=development

# Auth (API)
JWT_SECRET="change-this-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
JWT_REFRESH_REMEMBER_EXPIRES="30d"
PASSWORD_RESET_EXPIRES="1h"
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000"

# Media uploads (local disk)
UPLOAD_DIR="./uploads"
PUBLIC_API_URL="http://localhost:4001/api/v1"

# Seed
SEED_ADMIN_PASSWORD="ChangeMe123!"
