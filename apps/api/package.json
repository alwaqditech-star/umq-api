{
  "name": "@umq/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "prebuild": "pnpm --filter @umq/shared build",
    "predev": "node ../../scripts/free-dev-ports.mjs api && pnpm --filter @umq/shared build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "@umq/database": "workspace:*",
    "@umq/shared": "workspace:*",
    "@codegenie/serverless-express": "^4.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.14",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@umq/eslint-config": "workspace:*",
    "@umq/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": "20.x"
  }
}
