{
  "name": "@umq/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:migrate-from-omq": "dotenv -e ../../.env -- tsx scripts/migrate-from-omq.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@umq/shared": "workspace:*",
    "prisma": "^6.19.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@umq/eslint-config": "workspace:*",
    "@umq/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "mysql2": "^3.14.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  }
}
